{
  "name": "readmelens-pro-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ReadmeLens Pro: Full documentation platform, README viewer, analyzer, editor, and docs-site generator",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @readmelens/web test:e2e",
    "test:a11y": "pnpm --filter @readmelens/web test:a11y"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@12.18.0"
}
