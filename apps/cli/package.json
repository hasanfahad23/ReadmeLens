{
  "name": "@readmelens/cli",
  "version": "1.0.0",
  "description": "ReadmeLens CLI: view, lint, score, export, and generate READMEs directly from terminal",
  "bin": {
    "readmelens": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@readmelens/core": "workspace:*",
    "@readmelens/providers": "workspace:*",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
