# ReadmeLens Pro - Environment Configuration Example
# Copy this file to .env.local for local development.

# Canonical public site origin (must be https:// in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server Node Environment ('development' | 'test' | 'production')
NODE_ENV=development

# Optional: Upstash Redis (for rate limiting in production)
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...

# Optional: GitHub Personal Access Token (for increasing GitHub API rate limit from 60 to 5000 req/hr)
# GITHUB_TOKEN=
